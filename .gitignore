# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/

# uv
uv.lock.tmp

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# State the daemon writes at runtime — never committed (§68, §15.6)
*.db
*.db-journal
*.sqlite
*.sqlite3
# Anchored to the repo root: a top-level runtime state/log directory, not
# src/mcp_chatgpt_sandbox/jobs/ (the job store module) or tests/jobs/.
/state/
/jobs/

# Secrets and keys — never committed (§53, §19.1)
*.pem
*.key
keys/
.env

# IDE
#  JetBrains specific template is maintained in a separate JetBrains.gitignore
#  that can be found at
#  https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
.idea/
.vscode/


run_claude*.sh*
*~
