#!/bin/sh
# G2R-007 (docs/GAP2_SPEC.md): `core.hooksPath` is a single directory,
# not a search chain — activating this repository's hooks
# (`git config core.hooksPath .githooks`, docs/DEVELOPMENT.md) shadows
# the developer's global `core.hooksPath`. The proxy-hook symlinks in
# this directory invoke this dispatcher so the corresponding global
# hook remains reachable. G3R-011 adds the one same-name composition
# case: `.githooks/pre-commit` runs its local checks first, then invokes
# this file directly as `--hook-name pre-commit`.
#
# G3R-010 (docs/GAP3_SPEC.md): `git config --get` uses exit status 1 for
# a missing key. That benign absence is the only configuration failure
# this dispatcher converts to a no-op. Parse/read/execution failures
# keep Git's stderr visible and fail the hook instead of silently
# disabling a potentially security-relevant global hook.
#
# `commit-msg`, `post-checkout`, `post-commit`, `post-merge`, and
# `pre-push` in this directory are symlinks to this file. Git execs a
# hook by its literal path, and a symlinked exec preserves the invoked
# name in `$0` (verified), so `basename "$0"` recovers the hook name.
# Direct invocation is intentionally restricted to `pre-commit`; it is
# an internal composition path for G3R-011, not a generic caller-
# supplied path component.
set -eu

hook_name=$(basename "$0")
if [ "$hook_name" = "_global-hook-dispatch" ]; then
    if [ "$#" -lt 2 ] || [ "$1" != "--hook-name" ]; then
        echo "global hook dispatch: direct invocation requires '--hook-name pre-commit'" >&2
        exit 2
    fi
    hook_name=$2
    shift 2
    if [ "$hook_name" != "pre-commit" ]; then
        echo "global hook dispatch: direct invocation only supports pre-commit" >&2
        exit 2
    fi
fi

if global_hooks_dir=$(git config --global --get core.hooksPath); then
    :
else
    git_config_status=$?
    if [ "$git_config_status" -eq 1 ]; then
        global_hooks_dir=
    else
        printf 'global hook dispatch: failed to read global core.hooksPath (git config exit %s)\n' \
            "$git_config_status" >&2
        exit "$git_config_status"
    fi
fi

if [ -n "$global_hooks_dir" ]; then
    # git config values are not shell-expanded; a leading ~/ is common.
    # The quoting below is deliberate, not the SC2088 mistake it looks
    # like: this is matching whether the *string value* begins with a
    # literal "~/", not trying to expand a tilde ourselves via the case
    # pattern. Verified the other way round too — dash DOES tilde-expand
    # an *unquoted* case pattern (undocumented gotcha, differs from the
    # common "case patterns never expand" assumption), which would turn
    # `~/*` into `$HOME/*` and silently stop matching the literal string
    # from git config.
    # shellcheck disable=SC2088
    case "$global_hooks_dir" in
        "~/"*) global_hooks_dir="$HOME/${global_hooks_dir#\~/}" ;;
    esac
    global_hook="$global_hooks_dir/$hook_name"
    if [ -f "$global_hook" ] && [ -x "$global_hook" ]; then
        exec "$global_hook" "$@"
    fi
fi

exit 0
